# ============================================================
# Top 10 Bottom 5 Server — Environment Variables
# Copy to server/.env for local development
# ============================================================

# Your Gemini API key — get one free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Port to run the server on (Render sets this automatically)
PORT=3001

# Frontend URL for CORS (your Vercel deployment URL)
# Local development: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Set automatically by Render in production — used for self-ping keep-alive
# RENDER_EXTERNAL_URL=https://your-server.onrender.com
